# Configuração do Banco de Dados
# Obrigatório: URL de conexão do PostgreSQL
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@YOUR_HOST:5432/YOUR_DBNAME

# Segurança e Administração
# Obrigatório para habilitar rotas de ingestão e administração (/api/admin/*)
ADMIN_SECRET=YOUR_ADMIN_SECRET_HERE

# Inteligência Artificial (Google Gemini)
# Utilizada no backend para geração de resumos analíticos e explicações contextuais
GEMINI_API_KEY=

# Configurações do App
PORT=3000
NODE_ENV=development
